# sqlite database and its WAL/SHM sidecars
caravan.db*

# clean-shutdown marker (SPEC §2.3) — per-install runtime state
caravan.state

# built binary (the module is also named caravan, so anchor to the repo root)
/caravan

# Air development artifacts
/tmp/

# web toolchain — web/dist is deliberately NOT ignored: it is embedded via
# go:embed and a placeholder must exist for `go build` to work.
web/node_modules/

# macOS
.DS_Store

# Agents
.claude
.agents
.omp
.codex